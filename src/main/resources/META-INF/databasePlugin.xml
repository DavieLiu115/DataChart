<!--
  Database 插件专属扩展声明文件（可选依赖 com.intellij.database 存在时才加载）。
  DataChart 对 Database 插件的访问全部通过反射 + 运行时检查（TableDropHandler /
  DatabaseTableMetadataFetcher / TableMetadataService），无需编译期依赖，因此这里仅保留
  文件头占位。若后续引入直接引用 Database API 的扩展点，请在此文件中声明。
-->
<idea-plugin id="com.wd.DataChart">
    <extensions defaultExtensionNs="com.intellij">
    </extensions>
</idea-plugin>
