<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.wd.DataChart</id>

    <!-- 本地化资源包：plugin.xml 里的 %key 与通知组的 bundle/key 都从这里取文案。
         文件：src/main/resources/messages/DataChartBoundle.properties（+ _zh 中文） -->
    <resource-bundle>messages.DataChartBoundle</resource-bundle>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>DataChart</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="lerder@foxmail.com" url="https://github.com/DavieLiu115">Davie Liu</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <b>DataChart</b> is a plugin that visualizes database table structures on an interactive board.<br>
    <ul>
      <li>Drag database tables from the Database tool window onto the canvas to generate table-structure cards (columns, types, comments, primary-key / index markers)</li>
      <li>Draw connections to express relationships between tables (one-to-one / one-to-many / many-to-one / many-to-many)</li>
      <li>Supports canvas pan / zoom / snap alignment, card search, and table-structure synchronization</li>
      <li>Export the ER diagram to PDF or image, with dark / light theme adaptation</li>
    </ul>
    Board layout and table relationships are saved in a <b>.datachart</b> file.
    <hr>

    DataChart 是一个数据库表结构可视化看板插件。<br>
    <ul>
      <li>从 Database 工具窗口拖入数据库表，在画布上生成表结构卡片（字段、类型、注释、主键/索引标识）</li>
      <li>通过连线表达表之间的关联关系（一对一 / 一对多 / 多对一 / 多对多）</li>
      <li>支持画布平移 / 缩放 / 对齐磁吸、卡片搜索、同步表结构</li>
      <li>可将 ER 图导出为 PDF 或图片，支持深色 / 浅色主题适配</li>
    </ul>
    使用 <b>.datachart</b> 文件保存看板布局与表关系。
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Database 插件是 Ultimate 版才有，声明为可选依赖，运行时动态检查。
         config-file 指向仅在 Database 插件存在时才加载的扩展声明文件 -->
    <depends optional="true" config-file="databasePlugin.xml">com.intellij.database</depends>

    <idea-version since-build="223"/>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <fileType name="dataChart" extensions="datachart;" fileNames=".datachart" language="dataChart"
                implementationClass="com.wd.editor.DataToolsFileType"
                fieldName="INSTANCE_C"/>

        <!-- 编辑器：单个 FileEditorProvider，编辑器内部用 JBTabs 提供 Board / Text 两个页签。
             为什么顺序放内部做：平台不保证多个自定义 provider 的 Tab 顺序
             （PLACE_BEFORE/AFTER_DEFAULT_EDITOR 没有平台代码处理、EP 的 order 属性实测也无效）。
             Text 页用 JSON 类型的虚拟文件承载内容，因此高亮 / 格式化与真正的 .json 一致。
             policy=HIDE_OTHER_EDITORS：隐藏平台自带的文本编辑器等，避免 IDE 层多出 tab -->
        <fileEditorProvider implementation="com.wd.editor.DataChartEditorProvider"/>

        <!-- 抑制平台自带的文本编辑器对 .datachart 生效：它按自定义语言 dataChart 渲染（无高亮），
             且 Tab 名也叫 "Text"，会和我们编辑器内部的 JSON 高亮 Text 页混淆。
             ⚠️ policy 里的 HIDE_DEFAULT_EDITOR / HIDE_OTHER_EDITORS 挡不住独立 EP 注册的
             PsiAwareTextEditorProvider，只有 FileEditorProviderSuppressor（带 project/file 参数）能精准抑制 -->
        <fileEditorProviderSuppressor implementation="com.wd.editor.DataChartTextEditorSuppressor"/>

        <internalFileTemplate name="DataChart"/>

        <projectService serviceImplementation="com.wd.db.TableMetadataService"/>

        <!-- 通知组：用于导出 PDF / 图片等操作的系统通知。bundle/key 让通知组名也走资源包 -->
        <notificationGroup id="DataChart" displayType="BALLOON"
                bundle="messages.DataChartBoundle" key="DataChart.notification.group"/>
    </extensions>

</idea-plugin>